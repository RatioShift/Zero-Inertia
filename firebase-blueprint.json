{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with momentum statistics, gamification badges, and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user identifier matching request.auth.uid" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Callsign or displayed operative name" },
        "currentStreak": { "type": "number", "description": "Current consecutive active streak" },
        "longestStreak": { "type": "number", "description": "Longest active streak achieved" },
        "totalActiveDays": { "type": "number", "description": "Total active logged days" },
        "momentumScore": { "type": "number", "description": "Aggregate momentum score (0-100)" },
        "badges": { "type": "array", "description": "List of unlocked badge identifiers" },
        "createdAt": { "type": "string", "description": "ISO timestamp of registration" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["uid", "email", "displayName", "currentStreak", "momentumScore"]
    },
    "Mission": {
      "title": "Mission",
      "description": "Tactical execution campaign definition with custom duration and phases.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Mission identifier" },
        "userId": { "type": "string", "description": "Owner user identifier" },
        "name": { "type": "string", "description": "Operational campaign title" },
        "codename": { "type": "string", "description": "Tactical uppercase token" },
        "totalDays": { "type": "number", "description": "Target duration in days" },
        "startDate": { "type": "string", "description": "Start date formatted YYYY-MM-DD" },
        "description": { "type": "string", "description": "Scope and neuro-objective" },
        "status": { "type": "string", "enum": ["active", "completed", "archived"], "description": "Status of the mission" },
        "phases": { "type": "array", "description": "Strategic phase calibrations" },
        "coreRules": { "type": "array", "description": "Non-negotiable behavioral constraints" },
        "createdAt": { "type": "string", "description": "ISO creation timestamp" },
        "updatedAt": { "type": "string", "description": "ISO update timestamp" }
      },
      "required": ["id", "userId", "name", "totalDays", "startDate", "status", "phases"]
    },
    "DailyLog": {
      "title": "DailyLog",
      "description": "Daily status log with target, momentum classification, and MVO deconstruction.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log identifier" },
        "userId": { "type": "string", "description": "Owner user identifier" },
        "missionId": { "type": "string", "description": "Mission identifier" },
        "dayNumber": { "type": "number", "description": "1-based day index in campaign" },
        "date": { "type": "string", "description": "Date formatted YYYY-MM-DD" },
        "target": { "type": "string", "description": "Operational target description" },
        "level": { "type": "string", "enum": ["MAX", "STANDARD", "MVO", "MISSED"], "description": "Momentum level tier" },
        "microMvo": { "type": "string", "description": "2-minute minimum viable output" },
        "standardTarget": { "type": "string", "description": "70% target output" },
        "maxTarget": { "type": "string", "description": "100% target output" },
        "notes": { "type": "string", "description": "Tactical reflection notes" },
        "noveltyUsed": { "type": "string", "description": "Rule 4 novelty variation applied" },
        "emergencyTriggered": { "type": "boolean", "description": "Whether 2-min breaker was used" },
        "loggedAt": { "type": "string", "description": "ISO timestamp when logged" }
      },
      "required": ["id", "userId", "missionId", "dayNumber", "date", "level", "loggedAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public operative telemetry for community momentum leaderboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User identifier matching auth.uid" },
        "displayName": { "type": "string", "description": "Operative callsign" },
        "momentumScore": { "type": "number", "description": "Current momentum score" },
        "currentStreak": { "type": "number", "description": "Current consecutive active streak" },
        "totalActiveDays": { "type": "number", "description": "Total active days logged" },
        "badgeCount": { "type": "number", "description": "Number of badges unlocked" },
        "activeMissionName": { "type": "string", "description": "Title of current active mission" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last activity" }
      },
      "required": ["userId", "displayName", "momentumScore", "currentStreak", "totalActiveDays", "badgeCount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and momentum stats"
    },
    "/users/{userId}/missions/{missionId}": {
      "schema": { "$ref": "#/entities/Mission" },
      "description": "User tactical missions and campaigns"
    },
    "/users/{userId}/missions/{missionId}/logs/{logId}": {
      "schema": { "$ref": "#/entities/DailyLog" },
      "description": "Daily logs for a specific user mission"
    },
    "/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Community leaderboard scores for public ranking"
    }
  }
}
